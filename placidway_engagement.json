      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "hostUrl": "graph.facebook.com",
        "httpRequestMethod": "GET",
        "graphApiVersion": "v23.0",
        "node": "={{ $json.fb_post_id }}",
        "edge": "",
        "options": {
          "queryParameters": {
            "parameter": [
              {
                "name": "fields",
                "value": "reactions.summary(true).limit(0),comments.summary(true).limit(0),shares"
              }
            ]
          }
        }
      },
      "id": "baf5827f-8b83-484e-9e19-d15d1bdfb884",
      "name": "Facebook: read engagement",
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "position": [
        680,
        -40
      ],
      "credentials": {
        "facebookGraphApi": {
          "id": "pLrpWP58ZSYh2TN5",
          "name": "Facebook Graph account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pair each Graph API answer with the log row it came from (same order); failures stay visible.\nconst rows = $('Published posts').all().filter(r => r.json.fb_post_id);\nreturn $input.all().map((item, i) => {\n  const row = rows[i].json;\n  const g = item.json || {};\n  const failed = !!g.error || (g.reactions === undefined && g.comments === undefined && !g.id);\n  return { json: {\n    fb_post_id: row.fb_post_id,\n    url: row.url || '',\n    title: row.title || '',\n    reactions: g.reactions?.summary?.total_count ?? 0,\n    comments: g.comments?.summary?.total_count ?? 0,\n    shares: g.shares?.count ?? 0,\n    status: failed ? 'read_failed' : 'ok',\n    checked_at: new Date().toISOString(),\n  } };\n});"
      },
      "id": "134789c8-6206-4502-92fb-4f541d6fe666",
      "name": "Count reactions, comments, shares",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -40
      ]
    },
